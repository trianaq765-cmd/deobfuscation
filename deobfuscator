import os
import uuid
import asyncio
import subprocess
from config import Config

class DeobfuscatorError(Exception):
    pass

class Deobfuscator:
    def __init__(self):
        self.deob_path = Config.DEOBFUSCATOR_PATH
        self.stats = {
            'total': 0,
            'success': 0,
            'failed': 0
        }
    
    async def deobfuscate(
        self,
        code: str,
        trace_mode: str = 'off',
        pretty: bool = True,
        emit_snapshots: bool = False,
        emit_ast: bool = False
    ) -> dict:
        """
        Deobfuscate Lua code using the CLI tool
        """
        self.stats['total'] += 1
        request_id = str(uuid.uuid4())
        
        input_file = os.path.join(Config.UPLOAD_FOLDER, f'{request_id}.lua')
        output_file = os.path.join(Config.OUTPUT_FOLDER, f'{request_id}.deob.lua')
        
        try:
            # Write input code
            with open(input_file, 'w') as f:
                f.write(code)
            
            # Build command
            cmd = [
                'lua',
                'src/deob/cli.lua',
                input_file,
                '--out', output_file,
                '--trace', trace_mode
            ]
            
            if pretty:
                cmd.append('--pretty')
            else:
                cmd.append('--no-pretty')
            
            if emit_snapshots:
                snapshot_dir = os.path.join(Config.SNAPSHOT_FOLDER, request_id)
                os.makedirs(snapshot_dir, exist_ok=True)
                cmd.extend(['--emit-snapshots', snapshot_dir])
            
            if emit_ast:
                ast_file = os.path.join(Config.OUTPUT_FOLDER, f'{request_id}.ast.lua')
                cmd.extend(['--emit-ast', ast_file])
            
            # Run deobfuscator
            process = await asyncio.create_subprocess_exec(
                *cmd,
                cwd=self.deob_path,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.PIPE
            )
            
            try:
                stdout, stderr = await asyncio.wait_for(
                    process.communicate(),
                    timeout=Config.DEOB_TIMEOUT
                )
            except asyncio.TimeoutError:
                process.kill()
                raise DeobfuscatorError("Deobfuscation timed out (5 minute limit)")
            
            # Read output
            if os.path.exists(output_file):
                with open(output_file, 'r') as f:
                    output_code = f.read()
                
                self.stats['success'] += 1
                
                return {
                    'success': True,
                    'output': output_code,
                    'stdout': stdout.decode() if stdout else '',
                    'stderr': stderr.decode() if stderr else '',
                    'request_id': request_id
                }
            else:
                self.stats['failed'] += 1
                error_msg = stderr.decode() if stderr else stdout.decode() if stdout else 'Unknown error'
                raise DeobfuscatorError(f"Deobfuscation failed: {error_msg}")
        
        except DeobfuscatorError:
            raise
        except Exception as e:
            self.stats['failed'] += 1
            raise DeobfuscatorError(str(e))
        
        finally:
            # Cleanup
            for f in [input_file, output_file]:
                if os.path.exists(f):
                    try:
                        os.remove(f)
                    except:
                        pass
    
    async def deobfuscate_python(self, code: str) -> dict:
        """
        Deobfuscate using pol.py (Python method)
        """
        request_id = str(uuid.uuid4())
        input_file = os.path.join(Config.UPLOAD_FOLDER, f'{request_id}.lua')
        
        try:
            with open(input_file, 'w') as f:
                f.write(code)
            
            process = await asyncio.create_subprocess_exec(
                'python3', 'pol.py', input_file,
                cwd=self.deob_path,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.PIPE
            )
            
            stdout, stderr = await asyncio.wait_for(
                process.communicate(),
                timeout=Config.DEOB_TIMEOUT
            )
            
            return {
                'success': True,
                'output': stdout.decode() if stdout else '',
                'stderr': stderr.decode() if stderr else ''
            }
        
        except Exception as e:
            raise DeobfuscatorError(str(e))
        
        finally:
            if os.path.exists(input_file):
                os.remove(input_file)
    
    def get_stats(self):
        return self.stats.copy()

# Global instance
deobfuscator = Deobfuscator()
